generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  account_id                                            Int            @id @default(autoincrement())
  user_id                                               Int
  name                                                  String         @db.VarChar(100)
  account_type                                          String         @db.VarChar(20)
  balance                                               Decimal?       @default(0.00) @db.Decimal(12, 2)
  created_at                                            DateTime?      @default(now()) @db.Timestamp(6)
  users                                                 users          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  transactions_transactions_source_account_idToaccounts transactions[] @relation("transactions_source_account_idToaccounts")
  transactions_transactions_target_account_idToaccounts transactions[] @relation("transactions_target_account_idToaccounts")
}

model budget_plans {
  id              Int       @id @default(autoincrement())
  month           Int
  year            Int
  category_id     Int?
  budgeted_amount Decimal   @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model budgets {
  budget_id   Int        @id @default(autoincrement())
  user_id     Int
  category_id Int
  month_year  DateTime   @db.Date
  amount      Decimal    @db.Decimal(12, 2)
  categories  categories @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  category_id        Int            @id @default(autoincrement())
  user_id            Int
  name               String         @db.VarChar(50)
  category_type      String         @db.VarChar(10)
  is_fixed           Boolean?       @default(false)
  parent_category_id Int?
  created_at         DateTime?      @default(now()) @db.Timestamp(6)
  budgets            budgets[]
  categories         categories?    @relation("categoriesTocategories", fields: [parent_category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories   categories[]   @relation("categoriesTocategories")
  users              users          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  transactions       transactions[]
}

model debts {
  debt_id          Int       @id @default(autoincrement())
  user_id          Int
  provider         String    @db.VarChar(100)
  total_amount     Decimal   @db.Decimal(12, 2)
  paid_amount      Decimal?  @default(0.00) @db.Decimal(12, 2)
  remaining_amount Decimal?  @default(dbgenerated("(total_amount - paid_amount)")) @db.Decimal(12, 2)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model savings_goals {
  goal_id       Int       @id @default(autoincrement())
  user_id       Int
  name          String    @db.VarChar(100)
  target_amount Decimal   @db.Decimal(12, 2)
  saved_amount  Decimal?  @default(0.00) @db.Decimal(12, 2)
  due_date      DateTime? @db.Date
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  transaction_id                                    Int         @id @default(autoincrement())
  user_id                                           Int
  category_id                                       Int?
  amount                                            Decimal     @db.Decimal(12, 2)
  transaction_type                                  String      @db.VarChar(10)
  description                                       String?
  created_at                                        DateTime?   @default(now()) @db.Timestamp(6)
  source_account_id                                 Int?
  target_account_id                                 Int?
  categories                                        categories? @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  accounts_transactions_source_account_idToaccounts accounts?   @relation("transactions_source_account_idToaccounts", fields: [source_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  accounts_transactions_target_account_idToaccounts accounts?   @relation("transactions_target_account_idToaccounts", fields: [target_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  users                                             users       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  user_id       Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  email         String          @unique @db.VarChar(100)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  accounts      accounts[]
  budgets       budgets[]
  categories    categories[]
  debts         debts[]
  savings_goals savings_goals[]
  transactions  transactions[]
}
